local function getPos(obj)
    if obj:IsA("Model") then
        local prim = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        if prim then return prim.Position end
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end

local function isSmallItem(obj)
    if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then return false end
    local size
    if obj:IsA("Model") then
        local prim = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        if not prim then return false end
        size = prim.Size
    elseif obj:IsA("BasePart") then
        if obj.Anchored then return false end
        size = obj.Size
    else
        return false
    end
    return size.X <= 8 and size.Y <= 8 and size.Z <= 8
end

