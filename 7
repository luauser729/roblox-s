Tabs.Settings:Paragraph({
    Title = "边框颜色",
    Desc = "选择一个颜色，边框流动效果会立即切换",
})

Tabs.Settings:Dropdown({
    Title = "选择边框颜色",
    Values = { "深蓝", "红色", "紫色", "绿色", "金色", "粉色", "青色" },
    Value = { "深蓝" },
    Multi = false,
    AllowNone = false,
    Callback = function(sel)
        local colorName = sel[1] or "深蓝"
        local theme = BorderThemes[colorName]
        if theme then
            currentTheme = theme
            if Window and Window.UIElements and Window.UIElements.Main then
                local stroke = Window.UIElements.Main:FindFirstChild("FlowBorder")
                if stroke then
                    local g = stroke:FindFirstChild("StreamEffect")
                    if g then g.Color = theme end
                end
            end
            print("[设置] 边框颜色已切换为：" .. colorName)
        end
    end
})

Window:SelectTab(1)
