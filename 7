local hitboxEnabled = false
local hitboxScale = 2
local hitboxConnection = nil
local originalSizes = {}

local function isPlayerChar2(obj)
    for _, plr in pairs(game.Players:GetPlayers()) do
        if plr.Character and (obj == plr.Character or obj:IsDescendantOf(plr.Character)) then
            return true
        end
    end
    return false
end

local function isMonsterOrAnimal(obj)
    if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
        if isPlayerChar2(obj) then return false end
        return true
    end
    return false
end

local function setHitbox(obj, scale)
    if not obj or not obj:IsA("Model") then return end
    for _, part in ipairs(obj:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            if not originalSizes[part] then
                originalSizes[part] = part.Size
            end
            local orig = originalSizes[part]
            part.Size = Vector3.new(orig.X * scale, orig.Y * scale, orig.Z * scale)
        end
    end
end

local function startHitboxLoop()
    if hitboxConnection then return end
    hitboxConnection = RunService.Heartbeat:Connect(function()
        if not hitboxEnabled then return end
        for _, obj in pairs(workspace:GetDescendants()) do
            if isMonsterOrAnimal(obj) then
                setHitbox(obj, hitboxScale)
            end
        end
    end)
end

local function stopHitboxLoop()
    if hitboxConnection then hitboxConnection:Disconnect() hitboxConnection = nil end
    for part, origSize in pairs(originalSizes) do
        if part and part.Parent then
            pcall(function() part.Size = origSize end)
        end
    end
    originalSizes = {}
end

