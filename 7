local function updateLockQuickBtn()
    if not lockQuickBtn then return end
    if lockViewEnabled then
        lockQuickBtn.Text = "🔒"
        lockQuickBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        lockQuickBtn.BackgroundTransparency = 0.1
    else
        lockQuickBtn.Text = "🔓"
        lockQuickBtn.BackgroundColor3 = Color3.fromRGB(15, 110, 200)
        lockQuickBtn.BackgroundTransparency = 0.2
    end
end

local function setLockView(state)
    lockViewEnabled = state

    if lockViewConn then
        lockViewConn:Disconnect()
        lockViewConn = nil
    end

    if state then
        lockViewConn = game:GetService("RunService").RenderStepped:Connect(function()
            local char = game.Players.LocalPlayer.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            local camDir = workspace.CurrentCamera.CFrame.LookVector
            local flat = Vector3.new(camDir.X, 0, camDir.Z)
            if flat.Magnitude > 0.01 then
                root.CFrame = CFrame.new(root.Position, root.Position + flat.Unit)
            end
        end)
    end

    updateLockQuickBtn()
end

local function destroyLockQuickBtn()
    if lockQuickGui and lockQuickGui.Parent then
        lockQuickGui:Destroy()
    end
    lockQuickGui = nil
    lockQuickBtn = nil
end

