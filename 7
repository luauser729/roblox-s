local quickInteractEnabled = false
local quickInteractConn = nil

local function scanProximityPrompts()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            if not obj:GetAttribute("OrigHoldDuration") then
                obj:SetAttribute("OrigHoldDuration", obj.HoldDuration)
            end
            if quickInteractEnabled then
                obj.HoldDuration = 0
            else
                local orig = obj:GetAttribute("OrigHoldDuration")
                if orig then obj.HoldDuration = orig end
            end
        end
    end
end

