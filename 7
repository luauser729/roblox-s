local playerESPEnabled = false
local playerESPDrawings = {}  -- [角色] = {gui, box, nameLabel}

-- 创建一套屏幕 GUI（每帧更新位置和大小）
local function createPlayerESPGui(charName)
    local gui = Instance.new("ScreenGui")
    gui.Name = "ESP_" .. charName
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 999
    gui.Parent = game:GetService("CoreGui")

    -- 用 4 条 Frame 拼一个方框（每个 Frame 是边框的一条边）
    local top = Instance.new("Frame")
    top.Name = "Top"
    top.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
    top.BorderSizePixel = 0
    top.Parent = gui

    local bottom = Instance.new("Frame")
    bottom.Name = "Bottom"
    bottom.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
    bottom.BorderSizePixel = 0
    bottom.Parent = gui

    local left = Instance.new("Frame")
    left.Name = "Left"
    left.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
    left.BorderSizePixel = 0
    left.Parent = gui

    local right = Instance.new("Frame")
    right.Name = "Right"
    right.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
    right.BorderSizePixel = 0
    right.Parent = gui

    -- 名字 + 距离
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "Name"
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.TextSize = 14
    nameLabel.TextXAlignment = Enum.TextXAlignment.Center
    nameLabel.Text = charName
    nameLabel.Parent = gui

    return { gui = gui, top = top, bottom = bottom, left = left, right = right, nameLabel = nameLabel }
end

-- 销毁
local function removePlayerESPGui(char)
    if playerESPDrawings[char] then
        local data = playerESPDrawings[char]
        if data.gui and data.gui.Parent then
            data.gui:Destroy()
        end
        playerESPDrawings[char] = nil
    end
end

