    if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then return true end
    local name = obj.Name:lower()
    local humanoidNames = {"cultist", "zombie", "wolf", "bear", "deer", "rabbit", "fox", "npc", "monster", "player", "skeleton", "ghost", "spider", "snake", "boar", "animal", "mob"}
    for _, kw in ipairs(humanoidNames) do
        if name:find(kw) then return true end
    end
    return false
end

local function isBigModel(obj)
    if obj:IsA("Model") then
        local prim = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        if prim then
            local s = prim.Size
            if s.X > 8 or s.Y > 8 or s.Z > 8 then return true end
        end
    end
    return false
end

local function isSafeItem(obj)
    if isPlayer(obj) then return false end
    if isHumanoid(obj) then return false end
    if isBigModel(obj) then return false end
    return true
end

local function getDisplayList(cat)
    local list = {}
    for k, _ in pairs(CATEGORY_DATA[cat]) do table.insert(list, k) end
    table.sort(list)
    for i, v in ipairs(list) do
        if v == "全部" then
            table.remove(list, i)
            table.insert(list, 1, "全部")
            break
        end
    end
    return list
end

local function getPos(obj)
    if obj:IsA("Model") then
        local prim = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        if prim then return prim.Position end
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end

local function getTargetPosition()
    if pullTarget == "玩家" then
        local char = LocalPlayer.Character
        if not char then return nil end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return nil end
        return root.Position + Vector3.new(0, 3, 0)
    end
    if pullTarget == "火堆" then
        local pos = findSpawn()
        if pos then return pos + Vector3.new(0, 3, 0) end
    end
    if pullTarget == "工作台" then
        for _, obj in pairs(Workspace:GetDescendants()) do
            local n = obj.Name:lower()
            if n:find("workbench") or n:find("craft") then
                local pos = getPos(obj)
                if pos then return pos + Vector3.new(0, 3, 0) end
            end
        end
    end
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        return char.HumanoidRootPart.Position + Vector3.new(0, 3, 0)
    end
    return nil
end

local function convertToEnglish(cat, selected)
    local result = {}
    for _, name in ipairs(selected) do
        if name == "全部" then
            for k, v in pairs(CATEGORY_DATA[cat]) do
                if k ~= "全部" and v ~= "__ALL__" then table.insert(result, v) end
            end
        else
            local eng = CATEGORY_DATA[cat][name]
            if eng and eng ~= "__ALL__" then table.insert(result, eng) end
        end
    end
    return result
end

local function bringToTarget(obj, targetPos)
    pcall(function()
        if obj:IsA("Model") then
            obj:PivotTo(CFrame.new(targetPos))
        elseif obj:IsA("BasePart") then
            obj.CFrame = CFrame.new(targetPos)
        end
    end)
end

local function tryServerMove(obj, pos)
    local remoteNames = {"Pickup", "Grab", "TakeItem", "MoveItem", "DropItem", "PickupItem", "Interact", "Use"}
    for _, remoteName in ipairs(remoteNames) do
        local remote = game:GetService("ReplicatedStorage"):FindFirstChild(remoteName, true)
        if remote and remote:IsA("RemoteEvent") then
            pcall(function() remote:FireServer(obj) end)
        end
    end
end

function pullItems(cat, selected)
    if not selected or #selected == 0 then
        print("[" .. cat .. "] 请先选择物品")
        return
    end
    local englishList = convertToEnglish(cat, selected)
    if #englishList == 0 then return end
    local targetPos = getTargetPosition()
    if not targetPos then return end

    local count = 0
    for _, obj in pairs(Workspace:GetDescendants()) do
        if count >= maxPullCount then break end
        if (obj:IsA("Model") or obj:IsA("Part") or obj:IsA("MeshPart")) and isSafeItem(obj) then
            local matched = false
            for _, want in ipairs(englishList) do
                if obj.Name == want or obj.Name:lower() == want:lower() then
                    matched = true
                    break
                end
            end
            if matched then
                tryServerMove(obj, targetPos)
                bringToTarget(obj, targetPos)
                count = count + 1
            end
        end
    end
    print("[" .. cat .. "] 拉取完成，共 " .. count .. " 个")
end

