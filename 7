-- ===== 修改碰撞箱（仿神Hub，改为修改 NPC）=====
local hbAllEnabled, hbAllSize, hbAllColor, hbAllDepth, hbAllVisual = false, 10, Color3.fromRGB(0,100,255), 0.5, false
local hbAllConn, hbAllOriginals, hbAllHL = nil, {}, {}

local function isNPC(obj)
    if not obj:IsA("Model") then return false end
    if not obj:FindFirstChildOfClass("Humanoid") then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == obj then return false end
    end
    return true
end

local function hbAllApplyOne(npc)
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not hbAllOriginals[hrp] then
        hbAllOriginals[hrp] = {Size=hrp.Size, Transparency=hrp.Transparency, Color=hrp.Color, Material=hrp.Material, CanCollide=hrp.CanCollide}
    end
    hrp.Size = Vector3.new(hbAllSize, hbAllSize, hbAllSize)
    hrp.Color = hbAllColor
    hrp.Transparency = 1 - hbAllDepth
    hrp.Material = Enum.Material.ForceField
    hrp.CanCollide = false

    local hl = hbAllHL[npc]
    if hbAllVisual then
        if not hl or not hl.Parent then
            hl = Instance.new("Highlight")
            hl.FillTransparency = 1
            hl.OutlineColor = hbAllColor
            hl.OutlineTransparency = 0
            hl.Adornee = hrp
            hl.Parent = hrp
            hbAllHL[npc] = hl
        else
            hl.OutlineColor = hbAllColor
            hl.Adornee = hrp
        end
    else
        if hl then hl:Destroy() hbAllHL[npc] = nil end
    end
end

local function hbAllApply()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isNPC(obj) then hbAllApplyOne(obj) end
    end
end

local function hbAllRestore()
    for hrp, d in pairs(hbAllOriginals) do
        pcall(function()
            if hrp and hrp.Parent then
                hrp.Size = d.Size
                hrp.Transparency = d.Transparency
                hrp.Color = d.Color
                hrp.Material = d.Material
                hrp.CanCollide = d.CanCollide
            end
        end)
    end
    hbAllOriginals = {}
    for _, hl in pairs(hbAllHL) do pcall(function() hl:Destroy() end) end
    hbAllHL = {}
end

local function hbAllStartLoop()
    if hbAllConn then hbAllConn:Disconnect() hbAllConn = nil end
    if not hbAllEnabled then return end
    hbAllConn = RunService.Heartbeat:Connect(function()
        pcall(function() if hbAllEnabled then hbAllApply() end end)
    end)
end

