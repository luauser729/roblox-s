local absorbEnabled = false
local absorbRadius = 3.5
local absorbInterval = 1.0
local absorbFlags = {
    Log=false, Coal=false, Oil=false, Bandage=false,
    Carrot=false, Berry=false, Cake=false, Iron=false,
    Microwave=false, Screw=false, Fan=false, Tire=false,
    Rifle=false, RifleAmmo=false, LeatherBody=false,
    BrokenMicrowave=false, FuelCanister=false,
}
local absorbExcluded = {"Workbench","工作台","Table","Crafting"}
local absorbOilKw = {"Barrel","Oil","桶","油"}
local absorbIronKw = {"Iron","铁板","铁","Sheet","Metal"}
local absorbScrewKw = {"Screw","螺丝","钉","Bolt"}

local function absorbIsExcluded(obj)
    for _, name in ipairs(absorbExcluded) do
        if string.find(obj.Name, name) then return true end
        if obj.Parent and string.find(obj.Parent.Name, name) then return true end
    end
    return false
end

local function absorbHasKw(obj, kws)
    for _, kw in ipairs(kws) do
        if string.find(obj.Name, kw) then return true end
    end
    return false
end

local function absorbRun()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local allItems, processed = {}, {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            if absorbFlags.Log and obj.Name == "Log" and not processed[obj] and not absorbIsExcluded(obj) then
                table.insert(allItems, obj); processed[obj] = true
            end
            if absorbFlags.Coal and obj.Name == "Coal" and not processed[obj] and not absorbIsExcluded(obj) then
                table.insert(allItems, obj); processed[obj] = true
            end
        end

        if obj:IsA("Model") and not processed[obj] and not obj:FindFirstChild("Humanoid") and not absorbIsExcluded(obj) then
            local children = obj:GetChildren()
            local partCount, hasCap, hasMain, hasTie, hasHandle, hasPart, hasLeaf = 0, false, false, false, false, false, false
            local hasAttachPoint, hasBack, hasBase, hasGlass, hasStand = false, false, false, false, false
            local hasHead, hasMiddle, hasFans, hasRim, hasCenter = false, false, false, false, false

            for _, child in ipairs(children) do
                if child:IsA("BasePart") then
                    partCount = partCount + 1
                    local n = child.Name
                    if n == "Cap" then hasCap = true elseif n == "Main" then hasMain = true
                    elseif n == "Tie" then hasTie = true elseif n == "Handle" then hasHandle = true
                    elseif n == "Part" then hasPart = true elseif n == "Leaf" then hasLeaf = true
                    elseif n == "AttachPoint" then hasAttachPoint = true elseif n == "Back" then hasBack = true
                    elseif n == "Base" then hasBase = true elseif n == "Glass" then hasGlass = true
                    elseif n == "Stand" then hasStand = true elseif n == "Head" then hasHead = true
                    elseif n == "Middle" then hasMiddle = true elseif n == "Fans" then hasFans = true
                    elseif n == "Rim" then hasRim = true elseif n == "Center" then hasCenter = true
                    end
                end
            end

            local matched = false
            if absorbFlags.Oil and hasCap and hasMain and absorbHasKw(obj, absorbOilKw) then matched = true
            elseif absorbFlags.Bandage and hasTie and hasHandle then matched = true
            elseif absorbFlags.Carrot and hasPart and hasLeaf and hasHandle and not hasCap and not hasMain and not hasTie then matched = true
            elseif absorbFlags.Berry and hasPart and hasHandle and not hasLeaf and not hasCap and not hasMain and not hasTie then matched = true
            elseif absorbFlags.Cake and hasHandle and partCount == 1 and not hasCap and not hasMain and not hasTie and not hasPart and not hasLeaf then matched = true
            elseif absorbFlags.Iron and hasMain and not hasCap and not hasTie and not hasHandle and not hasPart and not hasLeaf and absorbHasKw(obj, absorbIronKw) then matched = true
            elseif absorbFlags.Microwave and hasPart and hasMain and hasBack and hasBase and hasGlass and hasAttachPoint then matched = true
            elseif absorbFlags.Screw and hasMain and not hasCap and not hasTie and not hasHandle and not hasPart and not hasLeaf and absorbHasKw(obj, absorbScrewKw) then matched = true
            elseif absorbFlags.Fan and hasStand and hasMain and hasHead and hasMiddle and hasFans then matched = true
            elseif absorbFlags.Tire and hasRim and hasCenter and hasMain and hasPart then matched = true
            elseif absorbFlags.Rifle and obj.Name == "Rifle" then matched = true
            elseif absorbFlags.RifleAmmo and obj.Name == "Rifle Ammo" then matched = true
            elseif absorbFlags.LeatherBody and obj.Name == "Leather Body" then matched = true
            elseif absorbFlags.BrokenMicrowave and obj.Name == "Broken Microwave" then matched = true
            elseif absorbFlags.FuelCanister and obj.Name == "Fuel Canister" then matched = true
            end

            if matched then
                table.insert(allItems, obj); processed[obj] = true
            end
        end
    end

    local total = #allItems
    if total > 0 then
        local radius, groundY = absorbRadius, hrp.Position.Y - 1.0
        local angleStep = (2 * math.pi) / total
        for i, obj in ipairs(allItems) do
            local angle = i * angleStep
            local tp = Vector3.new(hrp.Position.X + math.cos(angle) * radius, groundY, hrp.Position.Z + math.sin(angle) * radius)
            pcall(function()
                if obj:IsA("Model") then obj:PivotTo(CFrame.new(tp)) else obj.CFrame = CFrame.new(tp) end
            end)
        end
    end
end

task.spawn(function()
    while task.wait(absorbInterval) do
        if absorbEnabled then absorbRun() end
    end
end)

