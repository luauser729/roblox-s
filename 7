                        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
                    end
                end
            end)
            print("[杂乱] 无限跳跃已开启")
        else
            if infiniteJumpConnection then
                infiniteJumpConnection:Disconnect()
                infiniteJumpConnection = nil
            end
            print("[杂乱] 无限跳跃已关闭")
        end
    end
})

