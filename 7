local espLabels = {}

local function createESPLabel(obj, text, color)
    local data = espLabels[obj]
    if not data then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_Label"
        billboard.Size = UDim2.new(0, 60, 0, 14)
        billboard.AlwaysOnTop = true
        billboard.StudsOffset = Vector3.new(0, 2, 0)
        billboard.Adornee = obj
        billboard.Parent = obj

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = color
        label.TextStrokeTransparency = 0
        label.TextScaled = true
        label.Font = Enum.Font.SourceSansBold
        label.Text = text
        label.Parent = billboard

        espLabels[obj] = { billboard = billboard, textLabel = label }
    else
        if data.textLabel then
            data.textLabel.Text = text
            data.textLabel.TextColor3 = color
        end
    end
end

local function getObjectCategory(obj)
    local name = obj.Name:lower()
    for catName, data in pairs(espCategories) do
        if data.enabled and catName ~= "物品" then
            for _, kw in ipairs(data.keywords) do
                if name:find(kw) then
                    return catName, obj.Name, data.color
                end
            end
        end
    end
    if espCategories["物品"].enabled and isSmallItem(obj) then
        return "物品", obj.Name, espCategories["物品"].color
    end
    return nil
end

local espConnection = nil
local lastUpdate = 0

local function startESP()
    if espConnection then return end
    espConnection = RunService.Heartbeat:Connect(function()
        local now = tick()
        if now - lastUpdate < 0.05 then return end
        lastUpdate = now

        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local myPos = root.Position

        local anyEnabled = false
        for _, v in pairs(espCategories) do
            if v.enabled then anyEnabled = true break end
        end

        if not anyEnabled then
            for obj, data in pairs(espLabels) do
                if data.billboard and data.billboard.Parent then data.billboard:Destroy() end
            end
            espLabels = {}
            return
        end

        local currentObjects = {}
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("BasePart") then
                local pos = getPos(obj)
                if pos then
                    local dist = (pos - myPos).Magnitude
                    if dist < ESP_MAX_DIST then
                        local cat, text, color = getObjectCategory(obj)
                        if cat then
                            currentObjects[obj] = true
                            createESPLabel(obj, cat .. " [" .. math.floor(dist) .. "]", color)
                        end
                    end
                end
            end
        end

        for obj, data in pairs(espLabels) do
            if not currentObjects[obj] or not obj.Parent then
                if data.billboard and data.billboard.Parent then data.billboard:Destroy() end
                espLabels[obj] = nil
            end
        end
    end)
end

local function stopESP()
    if espConnection then espConnection:Disconnect() espConnection = nil end
    for obj, data in pairs(espLabels) do
        if data.billboard and data.billboard.Parent then data.billboard:Destroy() end
    end
    espLabels = {}
end

