local function removePlayerESPGui(char)
    if playerESPDrawings[char] then
        local data = playerESPDrawings[char]
        if data.gui and data.gui.Parent then data.gui:Destroy() end
        playerESPDrawings[char] = nil
    end
end

local function startPlayerESP()
    if playerESPLoop then return end
    playerESPLoop = RunService.RenderStepped:Connect(function()
        if not playerESPEnabled then return end

        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        local myPos = myRoot.Position

        local aliveChars = {}

        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local char = plr.Character
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local dist = (root.Position - myPos).Magnitude
                    if dist < MAX_ESP_DISTANCE then
                        aliveChars[char] = true

                        local data = playerESPDrawings[char]
                        if not data then
                            data = createPlayerESPGui(plr.Name)
                            playerESPDrawings[char] = data
                        end

                        local head = char:FindFirstChild("Head")
                        local headPos = head and head.Position or (root.Position + Vector3.new(0, 1.5, 0))
                        local feetPos = root.Position - Vector3.new(0, 3, 0)

                        local headScreen = Camera:WorldToViewportPoint(headPos + Vector3.new(0, 0.5, 0))
                        local feetScreen = Camera:WorldToViewportPoint(feetPos)
                        local center, onScreen = Camera:WorldToViewportPoint(root.Position)

                        local height = math.abs(feetScreen.Y - headScreen.Y)
                        local width = height * 0.6
                        local x = center.X - width / 2
                        local y = headScreen.Y

                        data.top.BackgroundColor3 = playerESPColor
                        data.bottom.BackgroundColor3 = playerESPColor
                        data.left.BackgroundColor3 = playerESPColor
                        data.right.BackgroundColor3 = playerESPColor
                        data.nameLabel.TextColor3 = playerESPColor

                        if onScreen and height > 2 then
                            data.top.Position = UDim2.new(0, x, 0, y)
                            data.top.Size = UDim2.new(0, width, 0, 2)
                            data.top.Visible = true

                            data.bottom.Position = UDim2.new(0, x, 0, y + height)
                            data.bottom.Size = UDim2.new(0, width, 0, 2)
                            data.bottom.Visible = true

                            data.left.Position = UDim2.new(0, x, 0, y)
                            data.left.Size = UDim2.new(0, 2, 0, height)
                            data.left.Visible = true

                            data.right.Position = UDim2.new(0, x + width, 0, y)
                            data.right.Size = UDim2.new(0, 2, 0, height)
                            data.right.Visible = true

                            if playerESPShowName or playerESPShowDist then
                                local txt = plr.Name
                                if playerESPShowDist then txt = txt .. " [" .. math.floor(dist) .. "m]" end
                                data.nameLabel.Position = UDim2.new(0, x - 30, 0, y - 18)
                                data.nameLabel.Size = UDim2.new(0, width + 60, 0, 16)
                                data.nameLabel.Text = txt
                                data.nameLabel.Visible = true
                            else
                                data.nameLabel.Visible = false
                            end
                        else
                            data.top.Visible = false
                            data.bottom.Visible = false
                            data.left.Visible = false
                            data.right.Visible = false
                            data.nameLabel.Visible = false
                        end
                    end
                end
            end
        end

        for ch, _ in pairs(playerESPDrawings) do
            if not aliveChars[ch] or not ch.Parent then
                removePlayerESPGui(ch)
            end
        end
    end)
end

local function stopPlayerESP()
    if playerESPLoop then
        playerESPLoop:Disconnect()
        playerESPLoop = nil
    end
    for ch, _ in pairs(playerESPDrawings) do
        removePlayerESPGui(ch)
    end
    playerESPDrawings = {}
end

